<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately NO permissions are declared here.

      In particular there is no android.permission.INTERNET: this keyboard must be structurally
      incapable of sending anything that is typed or spoken anywhere. RECORD_AUDIO is declared
      below for on-device dictation, and nothing else is expected to be needed.
      The checkHasNoInternet Gradle task enforces this at build time.

      RECORD_AUDIO is safe to grant precisely because INTERNET is absent: the microphone feeds a
      model inside this process and the audio has nowhere else it could go.
    -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".KeyboardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
          Requirement 3/4 tuning rig: labelled gesture collection. See docs/GESTURE_BANK.md.

          This is the app's only launcher entry, and it is inside this APK rather than beside it
          because it has to be: the keyboard hands it each finished gesture through an
          in-process singleton, and it reads the bank out of this app's own sandbox. The test
          pad, which shares none of that, is its own app in :testpad.
        -->
        <activity
            android:name=".GestureLabActivity"
            android:exported="true"
            android:icon="@mipmap/ic_lab"
            android:label="@string/gesture_lab_name"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          No layout and no history: it exists only to host the system permission dialog, which
          a keyboard cannot show for itself. Not exported, because only our own service
          starts it.
        -->
        <activity
            android:name=".asr.MicrophonePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
