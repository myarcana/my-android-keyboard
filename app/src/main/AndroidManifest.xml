<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately NO permissions are declared here.

      In particular there is no android.permission.INTERNET: this keyboard must be structurally
      incapable of sending anything that is typed or spoken anywhere. RECORD_AUDIO will be added
      in Phase 4 for on-device dictation, and nothing else is expected to be needed.
      The checkHasNoInternet Gradle task enforces this at build time.
    -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Development scratch pad: gives a focusable text field to test the keyboard against. -->
        <activity
            android:name=".TestPadActivity"
            android:exported="true"
            android:label="@string/testpad_name"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Requirement 3/4 tuning rig: labelled gesture collection. See docs/GESTURE_BANK.md.
          Its own launcher entry rather than a corner of the test pad, because a data-collection
          session is a thing you sit down to do.
        -->
        <activity
            android:name=".GestureLabActivity"
            android:exported="true"
            android:label="@string/gesture_lab_name"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
