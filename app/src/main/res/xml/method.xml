<?xml version="1.0" encoding="utf-8"?>
<!--
  Subtypes are the languages shown in the system keyboard switcher and cycled by the globe key.

  Both Chinese subtypes are Pinyin, typed on the ordinary QWERTY letters, and differ only in the
  script they produce: zh_TW writes Taiwan Traditional (including Taiwan vocabulary, 軟體 rather
  than the character-wise 軟件) and zh_CN writes Simplified. One dictionary serves both; the
  conversion is com.offlinekeyboard.ime.pinyin.Script.

  Zhuyin was declared here before it existed. It needs its own 37-symbol key layout, which is a
  keyboard rather than a setting, so the subtype is gone until that layout is. A language the
  globe key cycles to that then behaves as QWERTY pinyin is worse than one that is absent.
-->
<!--
  supportsInlineSuggestions is what makes password managers offer to fill from the suggestion
  strip. Without it the system never even asks this IME for an InlineSuggestionsRequest, so the
  manager falls back to its own dropdown over the field — which is why the strip stayed empty.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true">

    <subtype
        android:label="@string/subtype_en"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="layout=qwerty"
        android:isAsciiCapable="true" />

    <subtype
        android:label="@string/subtype_zh_tw_pinyin"
        android:imeSubtypeLocale="zh_TW"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="layout=qwerty,script=traditional" />

    <subtype
        android:label="@string/subtype_zh_cn"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="layout=qwerty,script=simplified" />
</input-method>
